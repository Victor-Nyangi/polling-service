# Copy to .env.local and fill in values from your Supabase project
# (Project Settings -> API). Never commit .env.local.
#
# Leaving these blank is supported: without the two NEXT_PUBLIC_ values the app
# runs in demo mode, serving fixtures from src/lib/demo-data.ts and disabling
# every mutation with an info notice.

# Project URL, e.g. https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Publishable "anon" key. Safe to expose to the browser — it is constrained by
# row level security, so keep the policies in supabase/schema.sql applied.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Secret "service_role" key. Bypasses row level security entirely, so it must
# never reach a component or server action. /api/health only reports whether it
# is present. Optional for local development.
SUPABASE_SERVICE_ROLE_KEY=
